# This file is used for testing API calls with the SEMS+ portal. It is not part of the plugin code.
# To use, install the REST Client extension (https://marketplace.visualstudio.com/items?itemName=humao.rest-client).
#
# The easiest way to test the whole flow is the probe script, which handles password hashing and
# request signing for you:
#
#   node scripts/sems-probe.mjs
#
# To use this file instead, create a .env file (never commit it):
#
#   ACCOUNT=first.last@example.com
#   PASSWORD=your_secure_password
#   STATION_ID=3b0039a3-4afd-4031-943c-e2d69fc32788
#   PWD_HASH=<output of: node scripts/sems-probe.mjs --hash>
#
# Gateway calls also need an x-signature header (sha256 over timestamp, uid and token). REST Client
# cannot compute it, so only the login request is runnable from here. Use the probe script for the rest.

### SEMS+ login
# @name auth
POST https://semsplus.goodwe.com/web/sems/sems-user/api/v1/auth/cross-login
Content-Type: application/json
Accept: application/json, text/plain, */*
Origin: https://semsplus.goodwe.com
Referer: https://semsplus.goodwe.com/
token: {"uid":"","timestamp":0,"token":"","client":"semsPlusWeb","version":"","language":"en"}

{"account":"{{$dotenv ACCOUNT}}","pwd":"{{$dotenv PWD_HASH}}","agreement":1,"isChinese":false,"isLocal":false}
